# SwitchWakerHD (this fork): which toolchain built the NRO, for the log and crash reports (switch_toolchain.h).
# Players build the NRO themselves, so their devkitPro can differ from ours; a crash address only maps to our ELF
# when the toolchain is the same (docs/pinned-toolchain-plan.md, step 1). Written into the build directory on
# every build, rewritten only when the text changes. Run as:
#   cmake -DOUT=<file> -DCC=<compiler> -DDEVKITPRO=<dir> -DUAM=<uam> -DHOST=<system> -P SwitchToolchainInfo.cmake
#
# The text: "gcc 15.2.0, libnx 4.12.0-1 a1b2c3d4, zlib ..., lz4 ..., uam ... on Linux (docker <image>, host Darwin)":
#   the compiler's version; each library and tool with its package version when a pacman can tell (devkitPro's
#   install or container) and the first 8 hex digits of its file's SHA-256 (the same file whatever pacman says);
#   the bundle id when the toolchain is a pinned bundle (DEVKITPRO/toolchain.json); the system it ran on; how build.sh ran it (WWHD_BUILD_ENV: "docker <image id>, host <system>", "native").

set(parts)
execute_process(COMMAND "${CC}" -dumpfullversion OUTPUT_VARIABLE cc_ver OUTPUT_STRIP_TRAILING_WHITESPACE
                ERROR_QUIET RESULT_VARIABLE rc)
if(rc EQUAL 0 AND cc_ver)
  list(APPEND parts "gcc ${cc_ver}")
else()
  list(APPEND parts "compiler unknown")
endif()

# package versions: devkitPro's pacman (native install), dkp-pacman (the container), or none
set(pacman "")
foreach(cand "${DEVKITPRO}/pacman/bin/pacman" "${DEVKITPRO}/msys2/usr/bin/pacman.exe" dkp-pacman)
  if(cand MATCHES "/" AND NOT EXISTS "${cand}")
    continue()
  endif()
  execute_process(COMMAND "${cand}" -Q libnx OUTPUT_QUIET ERROR_QUIET RESULT_VARIABLE rc)
  if(rc EQUAL 0)
    set(pacman "${cand}")
    break()
  endif()
endforeach()
function(pkg_version name out)
  set(${out} "" PARENT_SCOPE)
  if(pacman)
    execute_process(COMMAND "${pacman}" -Q ${name} OUTPUT_VARIABLE line OUTPUT_STRIP_TRAILING_WHITESPACE
                    ERROR_QUIET RESULT_VARIABLE rc)
    if(rc EQUAL 0 AND line MATCHES "^[^ ]+ (.+)$")
      set(${out} " ${CMAKE_MATCH_1}" PARENT_SCOPE)
    endif()
  endif()
endfunction()

# label, package, file
foreach(item "libnx|libnx|${DEVKITPRO}/libnx/lib/libnx.a"
             "zlib|switch-zlib|${DEVKITPRO}/portlibs/switch/lib/libz.a"
             "lz4|switch-lz4|${DEVKITPRO}/portlibs/switch/lib/liblz4.a"
             "uam|uam|${UAM}")
  string(REPLACE "|" ";" item "${item}")
  list(GET item 0 label)
  list(GET item 1 pkg)
  list(GET item 2 file)
  pkg_version(${pkg} ver)
  if(file AND EXISTS "${file}")
    file(SHA256 "${file}" digest)
    string(SUBSTRING "${digest}" 0 8 digest)
  else()
    set(digest "missing")
  endif()
  list(APPEND parts "${label}${ver} ${digest}")
endforeach()

if(EXISTS "${DEVKITPRO}/toolchain.json")
  file(READ "${DEVKITPRO}/toolchain.json" manifest)
  string(JSON bundle ERROR_VARIABLE err GET "${manifest}" id)
  if(NOT err)
    list(APPEND parts "bundle ${bundle}")
  endif()
endif()
list(JOIN parts ", " text)
string(APPEND text " on ${HOST}")
if(DEFINED ENV{WWHD_BUILD_ENV} AND NOT "$ENV{WWHD_BUILD_ENV}" STREQUAL "")
  string(APPEND text " ($ENV{WWHD_BUILD_ENV})")
endif()
# no quotes or backslashes in the C string
string(REGEX REPLACE "[\"\\\\]" "" text "${text}")

set(src "// generated by cmake/SwitchToolchainInfo.cmake; do not edit
#include \"platform/switch_toolchain.h\"
namespace switch_toolchain {
const char* info() { return \"${text}\"; }
}  // namespace switch_toolchain
")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL src)
  file(WRITE "${OUT}" "${src}")
endif()
