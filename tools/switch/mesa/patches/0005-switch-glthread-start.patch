+/* Switch (SwitchWakerHD, include/mesa_switch.h): start the current context's GL thread. switch-mesa's
+ * EGL never starts it and leaves st_manager::set_background_context empty, which the worker calls
+ * first; the application passes its own (it names the worker thread, sets its priority). */
+bool
+mesa_switch_glthread_start(void (*set_background_context)(struct st_context_iface *,
+                                                          struct util_queue_monitoring *))
+{
+   GET_CURRENT_CONTEXT(ctx);
+   if (!ctx || !ctx->st)
+      return false;
+   if (ctx->GLThread.enabled)
+      return true;
+   struct st_manager *smapi =
+      (struct st_manager *) ctx->st->iface.st_context_private;
+   if (!smapi->set_background_context)
+      smapi->set_background_context = set_background_context;
+   _mesa_glthread_init(ctx);
+   return ctx->GLThread.enabled;
+}
