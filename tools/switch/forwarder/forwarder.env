# Shared by build_forwarder.sh (sourced) and build_forwarder_windows.py (parsed): plain KEY=value lines,
# no quotes and no $. WWHD_FORWARDER_TITLE_ID in the environment overrides TITLE_ID in both scripts.

# "01FF" is outside the ranges used by retail titles (0100...), "57574844" is ASCII "WWHD"; the low 12 bits
# are 0 as for any base application.
TITLE_ID=01ff575748440000

# nx-hbloader v2.4.5
HBLOADER_URL=https://github.com/switchbrew/nx-hbloader.git
HBLOADER_COMMIT=82b95122c5ae8dc059bf23893ba7623c72c86773

# hacBrewPack v3.05, before the fork's WASM build (The-4n's repository is gone)
HACBREWPACK_URL=https://github.com/TooTallNate/hacBrewPack.git
HACBREWPACK_COMMIT=745b16ecfc9ce055743067d200572204cb2aac6c
