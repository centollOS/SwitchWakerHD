<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- .NET Framework 4.8: pre-installed on all Windows 10/11 — zero runtime dependency -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SwitchWakerHD-Installer</AssemblyName>
    <RootNamespace>SwitchWakerHD.Installer</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <!-- Exe metadata -->
    <AssemblyTitle>SwitchWakerHD Installer</AssemblyTitle>
    <AssemblyDescription>Automatic installer for SwitchWakerHD - Wind Waker HD on Nintendo Switch</AssemblyDescription>
    <Company>centollOS</Company>
    <Product>SwitchWakerHD</Product>
    <Copyright>SwitchWakerHD by centollOS (GPLv3) - github.com/centollOS/SwitchWakerHD</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
