<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SwitchWakerHD-Installer</AssemblyName>
    <RootNamespace>SwitchWakerHD.Installer</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <!-- Self-contained: no .NET runtime required on end-user machine -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Exe metadata shown in Windows file properties -->
    <AssemblyTitle>SwitchWakerHD Installer</AssemblyTitle>
    <AssemblyDescription>Automatic installer for SwitchWakerHD - Wind Waker HD on Nintendo Switch</AssemblyDescription>
    <Company>centollOS</Company>
    <Product>SwitchWakerHD</Product>
    <Copyright>SwitchWakerHD by centollOS (GPLv3) - github.com/centollOS/SwitchWakerHD</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
