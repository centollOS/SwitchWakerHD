<Window x:Class="SwitchWakerHD.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="860" Height="700" MinWidth="720" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="Assets/logo.png"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" FontFamily="Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        AllowDrop="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Background="{StaticResource Header}" Padding="28,18" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="64" Height="64" CornerRadius="12" Margin="0,0,18,0" VerticalAlignment="Center"
                BorderBrush="{StaticResource Line}" BorderThickness="1">
          <Border.Background>
            <ImageBrush ImageSource="Assets/logo.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border.Background>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="SwitchWakerHD" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock x:Name="TxtSubtitle" Style="{StaticResource Dim}" FontSize="13"/>
        </StackPanel>
        <Button x:Name="BtnLang" Grid.Column="2" Style="{StaticResource Secondary}" MinWidth="0" Padding="14,6"
                FontSize="13" VerticalAlignment="Center" Click="BtnLang_Click"/>
      </Grid>
    </Border>

    <!-- Pages -->
    <Grid Grid.Row="1" Margin="36,28,36,16">

      <!-- 1. Welcome -->
      <ScrollViewer x:Name="PageWelcome" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
          <TextBlock x:Name="TxtWelcomeH" Style="{StaticResource H1}"/>
          <TextBlock x:Name="TxtWelcomeBody" FontSize="15" LineHeight="22" Margin="0,0,0,22"/>
          <Border Background="{StaticResource Card}" CornerRadius="8" Padding="20,16" Margin="0,0,0,18">
            <StackPanel>
              <TextBlock x:Name="TxtWelcomeListH" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <TextBlock x:Name="TxtWelcomeLi1" Style="{StaticResource Dim}" Margin="0,0,0,6"/>
              <TextBlock x:Name="TxtWelcomeLi2" Style="{StaticResource Dim}" Margin="0,0,0,6"/>
              <TextBlock x:Name="TxtWelcomeLi3" Style="{StaticResource Dim}"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="TxtWelcomeNeed" Margin="0,0,0,10"/>
          <TextBlock x:Name="TxtWelcomeDir" Style="{StaticResource Dim}" FontSize="12"/>
        </StackPanel>
      </ScrollViewer>

      <!-- 2. Game -->
      <ScrollViewer x:Name="PageGame" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
          <TextBlock x:Name="TxtGameH" Style="{StaticResource H1}"/>
          <TextBlock x:Name="TxtGameBody" Style="{StaticResource Dim}" Margin="0,0,0,18"/>
          <RadioButton x:Name="OptWua" Style="{StaticResource ChoiceCard}" GroupName="fmt" Checked="Opt_Checked">
            <StackPanel>
              <TextBlock x:Name="TxtOptWua" FontWeight="SemiBold"/>
              <TextBlock x:Name="TxtOptWuaD" Style="{StaticResource Dim}" FontSize="13"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="OptImg" Style="{StaticResource ChoiceCard}" GroupName="fmt" Checked="Opt_Checked">
            <StackPanel>
              <TextBlock x:Name="TxtOptImg" FontWeight="SemiBold"/>
              <TextBlock x:Name="TxtOptImgD" Style="{StaticResource Dim}" FontSize="13"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="OptDir" Style="{StaticResource ChoiceCard}" GroupName="fmt" Checked="Opt_Checked">
            <StackPanel>
              <TextBlock x:Name="TxtOptDir" FontWeight="SemiBold"/>
              <TextBlock x:Name="TxtOptDirD" Style="{StaticResource Dim}" FontSize="13"/>
            </StackPanel>
          </RadioButton>
          <Border Background="{StaticResource Card}" CornerRadius="8" Padding="16,10" Margin="0,8,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="TxtGamePath" Style="{StaticResource Dim}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,12,0"/>
              <Button x:Name="BtnBrowse" Grid.Column="1" Style="{StaticResource Secondary}" Click="BtnBrowse_Click"/>
            </Grid>
          </Border>
          <TextBlock x:Name="TxtGameWarn" Foreground="{StaticResource Warn}" Margin="2,10,0,0" Visibility="Collapsed"/>

          <!-- Optional: the GameCube sea minimap (a code mod built into the game) -->
          <Border Background="{StaticResource Card}" CornerRadius="8" Padding="16,12" Margin="0,22,0,0">
            <StackPanel>
              <TextBlock x:Name="TxtMmH" FontWeight="SemiBold" Margin="0,0,0,4"/>
              <TextBlock x:Name="TxtMmD" Style="{StaticResource Dim}" FontSize="13" Margin="0,0,0,10"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtMmGame" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" Margin="0,0,12,0"/>
                <Button x:Name="BtnMmClear" Grid.Column="1" Style="{StaticResource Link}" Margin="0,0,8,0"
                        Click="BtnMmClear_Click" Visibility="Collapsed"/>
                <Button x:Name="BtnMmFolder" Grid.Column="2" Style="{StaticResource Link}" Margin="0,0,8,0"
                        Click="BtnMmFolder_Click"/>
                <Button x:Name="BtnMmPick" Grid.Column="3" Style="{StaticResource Secondary}" Click="BtnMmPick_Click"/>
              </Grid>
              <TextBlock x:Name="TxtMmNote" Style="{StaticResource Dim}" FontSize="12" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Border>

          <!-- Optional: the HOME-screen forwarder -->
          <Border Background="{StaticResource Card}" CornerRadius="8" Padding="16,12" Margin="0,22,0,0">
            <StackPanel>
              <TextBlock x:Name="TxtFwdH" FontWeight="SemiBold" Margin="0,0,0,4"/>
              <TextBlock x:Name="TxtFwdD" Style="{StaticResource Dim}" FontSize="13" Margin="0,0,0,10"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtFwdKeys" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" Margin="0,0,12,0"/>
                <Button x:Name="BtnFwdClear" Grid.Column="1" Style="{StaticResource Link}" Margin="0,0,8,0"
                        Click="BtnFwdClear_Click" Visibility="Collapsed"/>
                <Button x:Name="BtnFwdPick" Grid.Column="2" Style="{StaticResource Secondary}" Click="BtnFwdPick_Click"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- 3. Progress -->
      <!-- No layout rounding here, and whole star weights: .NET Framework's Grid can loop forever
           (Grid.SetFinalSizeMaxDiscrepancy) sharing space between fractional stars with rounding on -->
      <Grid x:Name="PageProgress" Visibility="Collapsed" UseLayoutRounding="False">
        <Grid.RowDefinitions>
          <RowDefinition Height="5*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition x:Name="LogRow" Height="0"/>
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="ProgressScroll" VerticalScrollBarVisibility="Auto">
        <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock x:Name="TxtProgH" Style="{StaticResource H1}"/>
          <TextBlock x:Name="TxtProgBody" Style="{StaticResource Dim}" Margin="0,0,0,16"/>
        </StackPanel>
        <StackPanel x:Name="StepsPanel" Grid.Row="1" Margin="0,0,0,10"/>
        <Grid Grid.Row="2" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="TxtStatus" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
          <TextBlock x:Name="TxtElapsed" Grid.Column="1" Style="{StaticResource Dim}" FontSize="13" Margin="12,0,0,0"/>
        </Grid>
        <ProgressBar x:Name="Bar" Grid.Row="3" IsIndeterminate="True" Margin="0,0,0,14"/>

        <StackPanel Grid.Row="4">
          <!-- Something the user has to do (devkitPro's own installer) -->
          <Border x:Name="Notice" Background="{StaticResource Card}" BorderBrush="{StaticResource Warn}"
                  BorderThickness="4,0,0,0" CornerRadius="6" Padding="18,14" Margin="0,0,0,14" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="TxtNoticeH" FontWeight="SemiBold" Foreground="{StaticResource Warn}" Margin="0,0,0,6"/>
              <TextBlock x:Name="TxtNotice" LineHeight="21" Margin="0,0,0,12"/>
              <Button x:Name="BtnNotice" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="BtnNotice_Click"/>
            </StackPanel>
          </Border>
        </StackPanel>

        </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="0,4,0,0">
          <!-- Failure -->
          <Border x:Name="ErrorBox" Background="{StaticResource Card}" BorderBrush="{StaticResource Bad}"
                  BorderThickness="4,0,0,0" CornerRadius="6" Padding="18,14" Margin="0,0,0,14" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="TxtErrorH" FontWeight="SemiBold" Foreground="{StaticResource Bad}" Margin="0,0,0,6"/>
              <TextBlock x:Name="TxtError"/>
              <TextBlock x:Name="TxtLogPath" Style="{StaticResource Dim}" FontSize="12" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <StackPanel Orientation="Horizontal" Margin="-6,0,0,6">
            <Button x:Name="BtnLog" Style="{StaticResource Link}" Click="BtnLog_Click"/>
            <Button x:Name="BtnLogCopy" Style="{StaticResource Link}" Click="BtnLogCopy_Click" Visibility="Collapsed"/>
            <Button x:Name="BtnLogOpen" Style="{StaticResource Link}" Click="BtnLogOpen_Click" Visibility="Collapsed"/>
          </StackPanel>
        </StackPanel>

        <TextBox x:Name="LogBox" Grid.Row="2" Visibility="Collapsed" IsReadOnly="True"
                 Background="{StaticResource LogBg}" Foreground="#C9D6E3" BorderBrush="{StaticResource Line}"
                 FontFamily="Consolas" FontSize="12" Padding="8" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
      </Grid>

      <!-- 4. Done -->
      <ScrollViewer x:Name="PageDone" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Grid Width="36" Height="36" Margin="0,0,14,0">
              <Ellipse Fill="{StaticResource Good}"/>
              <Path Stroke="#0E1A28" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round" Data="M10,18.5 L15.5,24 L26,13"/>
            </Grid>
            <TextBlock x:Name="TxtDoneH" Style="{StaticResource H1}" Margin="0" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="TxtDoneBody" Margin="0,8,0,4"/>
          <TextBlock x:Name="TxtXferSize" Style="{StaticResource Dim}" FontSize="13" Margin="0,0,0,14"/>

          <RadioButton x:Name="XferMtp" Style="{StaticResource ChoiceCard}" GroupName="xfer" Checked="Xfer_Checked">
            <StackPanel>
              <TextBlock x:Name="TxtXferMtp" FontWeight="SemiBold"/>
              <TextBlock x:Name="TxtXferMtpD" Style="{StaticResource Dim}" FontSize="13"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="XferSd" Style="{StaticResource ChoiceCard}" GroupName="xfer" Checked="Xfer_Checked">
            <StackPanel>
              <TextBlock x:Name="TxtXferSd" FontWeight="SemiBold"/>
              <TextBlock x:Name="TxtXferSdD" Style="{StaticResource Dim}" FontSize="13"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="XferManual" Style="{StaticResource ChoiceCard}" GroupName="xfer" Checked="Xfer_Checked">
            <StackPanel>
              <TextBlock x:Name="TxtXferManual" FontWeight="SemiBold"/>
              <TextBlock x:Name="TxtXferManualD" Style="{StaticResource Dim}" FontSize="13"/>
            </StackPanel>
          </RadioButton>

          <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                  CornerRadius="8" Padding="20,16" Margin="0,4,0,0">
            <StackPanel>
              <!-- DBI over USB -->
              <StackPanel x:Name="PanelMtp" Visibility="Collapsed">
                <TextBlock x:Name="TxtMtpSteps" LineHeight="22" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="TxtMtpLabel" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Button x:Name="BtnMtpRefresh" Grid.Column="1" Style="{StaticResource Link}" Click="BtnDevRefresh_Click"/>
                </Grid>
                <StackPanel x:Name="MtpList"/>
                <TextBlock x:Name="TxtMtpNone" Style="{StaticResource Dim}" Margin="0,0,0,10"/>
                <TextBlock x:Name="TxtMtpReplace" Style="{StaticResource Dim}" FontSize="12" Margin="0,0,0,10"/>
                <Button x:Name="BtnCopyMtp" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="BtnCopyMtp_Click"/>
              </StackPanel>
              <!-- microSD in the PC -->
              <StackPanel x:Name="PanelSd" Visibility="Collapsed">
                <TextBlock x:Name="TxtSdHint" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="TxtSdLabel" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Button x:Name="BtnSdRefresh" Grid.Column="1" Style="{StaticResource Link}" Click="BtnDevRefresh_Click"/>
                </Grid>
                <StackPanel x:Name="SdPanel"/>
                <TextBlock x:Name="TxtSdNone" Style="{StaticResource Dim}" Margin="0,0,0,10"/>
                <Button x:Name="BtnCopySd" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="BtnCopySd_Click"/>
              </StackPanel>
              <!-- By hand -->
              <StackPanel x:Name="PanelManual" Visibility="Collapsed">
                <TextBlock x:Name="TxtManual" Margin="0,0,0,12"/>
                <Border Background="{StaticResource LogBg}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                  <TextBlock x:Name="TxtOut" Style="{StaticResource Dim}" FontFamily="Consolas" FontSize="12"
                             TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </Border>
                <Button x:Name="BtnOpenOut" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="BtnOpenOut_Click"/>
              </StackPanel>

              <TextBlock x:Name="TxtXferStatus" Margin="0,12,0,0" Visibility="Collapsed"/>
              <ProgressBar x:Name="XferBar" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource Card}" CornerRadius="8" Padding="20,16" Margin="0,18,0,0">
            <StackPanel>
              <TextBlock x:Name="TxtNextH" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <TextBlock x:Name="TxtNext1" Style="{StaticResource Dim}" Margin="0,0,0,6"/>
              <TextBlock x:Name="TxtNext2" Style="{StaticResource Dim}" Margin="0,0,0,6"/>
              <TextBlock x:Name="TxtNext3" Style="{StaticResource Dim}" Margin="0,0,0,6"/>
              <TextBlock x:Name="TxtNext4" Style="{StaticResource Dim}"/>
              <TextBlock x:Name="TxtFwdDone" Margin="0,10,0,0" Visibility="Collapsed"/>
              <TextBlock x:Name="TxtMmDone" Margin="0,10,0,0" Visibility="Collapsed"/>
              <TextBlock x:Name="TxtGameFilesDone" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Footer -->
    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="28,14">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BtnSecondary" Style="{StaticResource Secondary}" Margin="0,0,10,0" Click="BtnSecondary_Click"/>
        <Button x:Name="BtnPrimary" Style="{StaticResource Primary}" IsDefault="True" Click="BtnPrimary_Click"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
