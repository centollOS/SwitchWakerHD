<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SwitchWakerHD.Installer.MainWindow"
        Width="860" Height="720" MinWidth="720" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="/Assets/logo.png"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" FontSize="14"
        DragDrop.AllowDrop="True">
  <Panel>
    <Grid RowDefinitions="Auto,*,Auto">
      <!-- Header -->
      <Border Background="{StaticResource Header}" Padding="28,18" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border Width="64" Height="64" CornerRadius="12" Margin="0,0,18,0" VerticalAlignment="Center" ClipToBounds="True"
                  BorderBrush="{StaticResource Line}" BorderThickness="1">
            <Image Source="/Assets/logo.png" Stretch="UniformToFill"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="SwitchWakerHD" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="TxtSubtitle" Classes="dim" FontSize="13"/>
          </StackPanel>
          <Button x:Name="BtnLang" Grid.Column="2" Classes="secondary" MinWidth="0" Padding="14,6" FontSize="13"
                  VerticalAlignment="Center" Click="BtnLang_Click"/>
        </Grid>
      </Border>

      <!-- Pages -->
      <Panel Grid.Row="1" Margin="36,28,36,16">
        <!-- 1. Welcome -->
        <ScrollViewer x:Name="PageWelcome">
          <StackPanel MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock x:Name="TxtWelcomeH" Classes="h1"/>
            <TextBlock x:Name="TxtWelcomeBody" FontSize="15" LineHeight="22" Margin="0,0,0,22"/>
            <Border Background="{StaticResource Card}" CornerRadius="8" Padding="20,16" Margin="0,0,0,18">
              <StackPanel Spacing="6">
                <TextBlock x:Name="TxtWelcomeListH" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtWelcomeLi1" Classes="dim"/>
                <TextBlock x:Name="TxtWelcomeLi2" Classes="dim"/>
                <TextBlock x:Name="TxtWelcomeLi3" Classes="dim"/>
              </StackPanel>
            </Border>
            <TextBlock x:Name="TxtWelcomeNeed" Margin="0,0,0,6"/>
            <TextBlock x:Name="TxtWelcomeAdmin" Classes="dim" Margin="0,0,0,10"/>
            <TextBlock x:Name="TxtWelcomeDir" Classes="dim" FontSize="12"/>
          </StackPanel>
        </ScrollViewer>

        <!-- 2. Game -->
        <ScrollViewer x:Name="PageGame" IsVisible="False">
          <StackPanel MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock x:Name="TxtGameH" Classes="h1"/>
            <TextBlock x:Name="TxtGameBody" Classes="dim" Margin="0,0,0,18"/>
            <RadioButton x:Name="OptWua" Classes="card" GroupName="fmt" IsCheckedChanged="Opt_Changed">
              <StackPanel>
                <TextBlock x:Name="TxtOptWua" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtOptWuaD" Classes="dim" FontSize="13"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="OptImg" Classes="card" GroupName="fmt" IsCheckedChanged="Opt_Changed">
              <StackPanel>
                <TextBlock x:Name="TxtOptImg" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtOptImgD" Classes="dim" FontSize="13"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="OptDir" Classes="card" GroupName="fmt" IsCheckedChanged="Opt_Changed">
              <StackPanel>
                <TextBlock x:Name="TxtOptDir" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtOptDirD" Classes="dim" FontSize="13"/>
              </StackPanel>
            </RadioButton>
            <Border Background="{StaticResource Card}" CornerRadius="8" Padding="16,10" Margin="0,8,0,0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="TxtGamePath" Classes="dim" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" Margin="0,0,12,0"/>
                <Button x:Name="BtnBrowse" Grid.Column="1" Classes="secondary" Click="BtnBrowse_Click"/>
              </Grid>
            </Border>
            <TextBlock x:Name="TxtGameWarn" Foreground="{StaticResource Warn}" Margin="2,10,0,0" IsVisible="False"/>

            <!-- Optional: the GameCube sea minimap (a code mod built into the game) -->
            <Border Background="{StaticResource Card}" CornerRadius="8" Padding="16,12" Margin="0,22,0,0">
              <StackPanel>
                <TextBlock x:Name="TxtMmH" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtMmD" Classes="dim" FontSize="13" Margin="0,0,0,10"/>
                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                  <TextBlock x:Name="TxtMmGame" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             TextWrapping="NoWrap" Margin="0,0,12,0"/>
                  <Button x:Name="BtnMmClear" Grid.Column="1" Classes="link" Margin="0,0,8,0" Click="BtnMmClear_Click" IsVisible="False"/>
                  <Button x:Name="BtnMmFolder" Grid.Column="2" Classes="link" Margin="0,0,8,0" Click="BtnMmFolder_Click"/>
                  <Button x:Name="BtnMmPick" Grid.Column="3" Classes="secondary" Click="BtnMmPick_Click"/>
                </Grid>
                <TextBlock x:Name="TxtMmNote" Classes="dim" FontSize="12" Margin="0,8,0,0" IsVisible="False"/>
              </StackPanel>
            </Border>

            <!-- Optional: the HOME-screen forwarder -->
            <Border Background="{StaticResource Card}" CornerRadius="8" Padding="16,12" Margin="0,22,0,0">
              <StackPanel>
                <TextBlock x:Name="TxtFwdH" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtFwdD" Classes="dim" FontSize="13" Margin="0,0,0,10"/>
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock x:Name="TxtFwdKeys" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             TextWrapping="NoWrap" Margin="0,0,12,0"/>
                  <Button x:Name="BtnFwdClear" Grid.Column="1" Classes="link" Margin="0,0,8,0" Click="BtnFwdClear_Click" IsVisible="False"/>
                  <Button x:Name="BtnFwdPick" Grid.Column="2" Classes="secondary" Click="BtnFwdPick_Click"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- 3. Progress -->
        <Grid x:Name="PageProgress" IsVisible="False" RowDefinitions="5*,Auto,0">
          <ScrollViewer>
            <StackPanel>
              <TextBlock x:Name="TxtProgH" Classes="h1"/>
              <TextBlock x:Name="TxtProgBody" Classes="dim" Margin="0,0,0,16"/>
              <StackPanel x:Name="StepsPanel" Margin="0,0,0,10"/>
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <TextBlock x:Name="TxtStatus" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <TextBlock x:Name="TxtElapsed" Grid.Column="1" Classes="dim" FontSize="13" Margin="12,0,0,0"/>
              </Grid>
              <ProgressBar x:Name="Bar" IsIndeterminate="True" Margin="0,0,0,14"/>
              <!-- Something the user has to do (Apple's Command Line Tools window, the password) -->
              <Border x:Name="Notice" Background="{StaticResource Card}" BorderBrush="{StaticResource Warn}"
                      BorderThickness="4,0,0,0" CornerRadius="6" Padding="18,14" Margin="0,0,0,14" IsVisible="False">
                <StackPanel>
                  <TextBlock x:Name="TxtNoticeH" FontWeight="SemiBold" Foreground="{StaticResource Warn}" Margin="0,0,0,6"/>
                  <TextBlock x:Name="TxtNotice" LineHeight="21" Margin="0,0,0,12"/>
                  <!-- a command to paste in a terminal (Linux without a password window) -->
                  <Border x:Name="NoticeCmd" Background="{StaticResource LogBg}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12" IsVisible="False">
                    <SelectableTextBlock x:Name="TxtNoticeCmd" FontFamily="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap"/>
                  </Border>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="BtnNotice" Classes="primary" Click="BtnNotice_Click"/>
                    <Button x:Name="BtnNoticeCopy" Classes="secondary" Click="BtnNoticeCopy_Click" IsVisible="False"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="1" Margin="0,4,0,0">
            <!-- Failure -->
            <Border x:Name="ErrorBox" Background="{StaticResource Card}" BorderBrush="{StaticResource Bad}"
                    BorderThickness="4,0,0,0" CornerRadius="6" Padding="18,14" Margin="0,0,0,14" IsVisible="False">
              <StackPanel>
                <TextBlock x:Name="TxtErrorH" FontWeight="SemiBold" Foreground="{StaticResource Bad}" Margin="0,0,0,6"/>
                <SelectableTextBlock x:Name="TxtError" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtLogPath" Classes="dim" FontSize="12" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="-6,0,0,6">
              <Button x:Name="BtnLog" Classes="link" Click="BtnLog_Click"/>
              <Button x:Name="BtnLogCopy" Classes="link" Click="BtnLogCopy_Click" IsVisible="False"/>
              <Button x:Name="BtnLogOpen" Classes="link" Click="BtnLogOpen_Click" IsVisible="False"/>
            </StackPanel>
          </StackPanel>
          <TextBox x:Name="LogBox" Grid.Row="2" IsVisible="False" IsReadOnly="True" AcceptsReturn="True"
                   Background="{StaticResource LogBg}" Foreground="#C9D6E3" BorderBrush="{StaticResource Line}"
                   FontFamily="{StaticResource Mono}" FontSize="12" Padding="8" TextWrapping="NoWrap"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </Grid>

        <!-- 4. Done -->
        <ScrollViewer x:Name="PageDone" IsVisible="False">
          <StackPanel MaxWidth="680" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Panel Width="36" Height="36" Margin="0,0,14,0">
                <Ellipse Fill="{StaticResource Good}"/>
                <Path Stroke="#0E1A28" StrokeThickness="3.5" StrokeLineCap="Round" StrokeJoin="Round"
                      Data="M10,18.5 L15.5,24 L26,13"/>
              </Panel>
              <TextBlock x:Name="TxtDoneH" Classes="h1" Margin="0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="TxtDoneBody" Margin="0,8,0,4"/>
            <TextBlock x:Name="TxtXferSize" Classes="dim" FontSize="13" Margin="0,0,0,14"/>
            <!-- Linux only (gio): DBI's MTP responder -->
            <RadioButton x:Name="XferMtp" Classes="card" GroupName="xfer" IsCheckedChanged="Xfer_Changed" IsVisible="False">
              <StackPanel>
                <TextBlock x:Name="TxtXferMtp" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtXferMtpD" Classes="dim" FontSize="13"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="XferSd" Classes="card" GroupName="xfer" IsCheckedChanged="Xfer_Changed">
              <StackPanel>
                <TextBlock x:Name="TxtXferSd" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtXferSdD" Classes="dim" FontSize="13"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="XferManual" Classes="card" GroupName="xfer" IsCheckedChanged="Xfer_Changed">
              <StackPanel>
                <TextBlock x:Name="TxtXferManual" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtXferManualD" Classes="dim" FontSize="13"/>
              </StackPanel>
            </RadioButton>
            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="8" Padding="20,16" Margin="0,4,0,0">
              <StackPanel>
                <!-- DBI over USB (Linux) -->
                <StackPanel x:Name="PanelMtp" IsVisible="False">
                  <TextBlock x:Name="TxtMtpSteps" LineHeight="22" Margin="0,0,0,12"/>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock x:Name="TxtMtpLabel" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button x:Name="BtnMtpRefresh" Grid.Column="1" Classes="link" Click="BtnDevRefresh_Click"/>
                  </Grid>
                  <StackPanel x:Name="MtpList"/>
                  <TextBlock x:Name="TxtMtpNone" Classes="dim" Margin="0,0,0,10"/>
                  <TextBlock x:Name="TxtMtpReplace" Classes="dim" FontSize="12" Margin="0,0,0,10"/>
                  <Button x:Name="BtnCopyMtp" Classes="primary" HorizontalAlignment="Left" Click="BtnCopyMtp_Click"/>
                </StackPanel>
                <!-- The microSD in the computer: a card reader, or hekate's USB mass storage -->
                <StackPanel x:Name="PanelSd" IsVisible="False">
                  <TextBlock x:Name="TxtSdHint" LineHeight="21" Margin="0,0,0,12"/>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                    <TextBlock x:Name="TxtSdLabel" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button x:Name="BtnSdRefresh" Grid.Column="1" Classes="link" Click="BtnDevRefresh_Click"/>
                  </Grid>
                  <StackPanel x:Name="SdList"/>
                  <TextBlock x:Name="TxtSdNone" Classes="dim" Margin="0,0,0,10"/>
                  <Button x:Name="BtnCopySd" Classes="primary" HorizontalAlignment="Left" Click="BtnCopySd_Click"/>
                </StackPanel>
                <!-- By hand -->
                <StackPanel x:Name="PanelManual" IsVisible="False">
                  <TextBlock x:Name="TxtManual" Margin="0,0,0,12"/>
                  <Border Background="{StaticResource LogBg}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                    <SelectableTextBlock x:Name="TxtOut" Foreground="{StaticResource FgDim}" FontFamily="{StaticResource Mono}"
                                         FontSize="12" TextWrapping="NoWrap"/>
                  </Border>
                  <Button x:Name="BtnOpenOut" Classes="primary" HorizontalAlignment="Left" Click="BtnOpenOut_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtXferStatus" Margin="0,12,0,0" IsVisible="False"/>
                <ProgressBar x:Name="XferBar" Margin="0,8,0,0" IsVisible="False"/>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource Card}" CornerRadius="8" Padding="20,16" Margin="0,18,0,0">
              <StackPanel Spacing="6">
                <TextBlock x:Name="TxtNextH" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock x:Name="TxtNext1" Classes="dim"/>
                <TextBlock x:Name="TxtNext2" Classes="dim"/>
                <TextBlock x:Name="TxtNext3" Classes="dim"/>
                <TextBlock x:Name="TxtNext4" Classes="dim"/>
                <TextBlock x:Name="TxtFwdDone" Margin="0,4,0,0" IsVisible="False"/>
                <TextBlock x:Name="TxtMmDone" Margin="0,4,0,0" IsVisible="False"/>
                <TextBlock x:Name="TxtGameFilesDone" Margin="0,4,0,0" TextWrapping="Wrap" IsVisible="False"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Panel>

      <!-- Footer -->
      <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="28,14">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
          <Button x:Name="BtnSecondary" Classes="secondary" Click="BtnSecondary_Click"/>
          <Button x:Name="BtnPrimary" Classes="primary" IsDefault="True" Click="BtnPrimary_Click"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Yes/No over the window (cancel) -->
    <Border x:Name="Confirm" IsVisible="False" Background="#B0060D16">
      <Border Background="{StaticResource Card}" CornerRadius="10" Padding="24,20" MaxWidth="460"
              HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource Line}" BorderThickness="1">
        <StackPanel Spacing="18">
          <TextBlock x:Name="TxtConfirm" FontSize="15"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button x:Name="BtnConfirmNo" Classes="secondary" Click="BtnConfirm_Click"/>
            <Button x:Name="BtnConfirmYes" Classes="primary" Click="BtnConfirm_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Panel>
</Window>
