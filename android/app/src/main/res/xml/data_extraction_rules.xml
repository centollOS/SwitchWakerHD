<?xml version="1.0" encoding="utf-8"?>
<!-- Android backup (Google account, and moving to a new phone): only the save and the settings. The
     game files, the shader cache and the save states stay out (big, and the game is the user's own
     copy). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="external" path="save/" />
        <include domain="external" path="config/wwhd/android.txt" />
    </cloud-backup>
    <device-transfer>
        <include domain="external" path="save/" />
        <include domain="external" path="config/wwhd/android.txt" />
    </device-transfer>
</data-extraction-rules>
